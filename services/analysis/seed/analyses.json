[
  {
    "name": "thermalSolver",
    "kind": "external",
    "description": "Radiator temperature from heat load (demo external REST service).",
    "endpointUrl": "http://demo-external:8010/thermal",
    "inputs": [{"name": "power", "unit": "W"}, {"name": "area", "unit": "m**2"}, {"name": "ambient", "unit": "K"}],
    "outputs": [{"name": "tMax", "unit": "K"}, {"name": "margin", "unit": "K"}],
    "timeoutSeconds": 20
  },
  {
    "name": "fuelCost",
    "kind": "formula",
    "description": "Yearly fuel cost from range, tank capacity and fuel price.",
    "inputs": [{"name": "kmPerYear"}, {"name": "capacity"}, {"name": "range"}, {"name": "pricePerLitre"}],
    "outputs": [{"name": "cost"}],
    "formulas": {"cost": "kmPerYear / range * capacity * pricePerLitre"}
  }
]

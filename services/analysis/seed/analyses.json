[
  {
    "name": "missionSimulator",
    "kind": "external",
    "description": "Time-stepped mission simulation of a battery multirotor: energy drawn, percent of the pack, mission time, state of charge (mission simulator service).",
    "endpointUrl": "http://mission-sim:8011/simulate",
    "inputs": [
      {
        "name": "steps",
        "description": "flown steps: name, behavior, duration (s), powerFactor, releasesPayload"
      },
      {
        "name": "hoverPower",
        "unit": "W"
      },
      {
        "name": "takeoffMass",
        "unit": "kg"
      },
      {
        "name": "payloadMass",
        "unit": "kg"
      },
      {
        "name": "batteryEnergy",
        "unit": "Wh"
      },
      {
        "name": "batteryMaxPower",
        "unit": "W"
      },
      {
        "name": "reserve",
        "description": "fraction of the pack kept back"
      }
    ],
    "outputs": [
      {
        "name": "energyUsed",
        "unit": "Wh"
      },
      {
        "name": "energyPercent",
        "unit": "%"
      },
      {
        "name": "energyDelivered",
        "unit": "Wh"
      },
      {
        "name": "missionTime",
        "unit": "s"
      },
      {
        "name": "endStateOfCharge",
        "unit": "%"
      },
      {
        "name": "reserveMargin",
        "unit": "%"
      },
      {
        "name": "peakPower",
        "unit": "W"
      },
      {
        "name": "averagePower",
        "unit": "W"
      },
      {
        "name": "completed"
      },
      {
        "name": "feasible"
      },
      {
        "name": "limitingStep"
      },
      {
        "name": "issues"
      },
      {
        "name": "flownSteps"
      },
      {
        "name": "timeline"
      }
    ],
    "timeoutSeconds": 30
  },
  {
    "name": "fuelCost",
    "kind": "formula",
    "description": "Yearly fuel cost from range, tank capacity and fuel price.",
    "inputs": [
      {
        "name": "kmPerYear"
      },
      {
        "name": "capacity"
      },
      {
        "name": "range"
      },
      {
        "name": "pricePerLitre"
      }
    ],
    "outputs": [
      {
        "name": "cost"
      }
    ],
    "formulas": {
      "cost": "kmPerYear / range * capacity * pricePerLitre"
    }
  },
  {
    "name": "dynamicsSimulator",
    "kind": "external",
    "description": "Dynamic mission simulation of a battery multirotor: propeller thrust/power curves against advance ratio, brushless motor model, drag, acceleration transients and battery sag; energy and power per behavior (mission simulator service). Still air, constant air density.",
    "endpointUrl": "http://mission-sim:8011/dynamics",
    "inputs": [
      {
        "name": "steps",
        "description": "flown steps: name, behavior, duration (s), groundSpeed, verticalSpeed (m/s), airborne, releasesPayload"
      },
      {
        "name": "rotorCount"
      },
      {
        "name": "takeoffMass",
        "unit": "kg"
      },
      {
        "name": "payloadMass",
        "unit": "kg"
      },
      {
        "name": "dragArea",
        "unit": "m2",
        "description": "drag coefficient × frontal area"
      },
      {
        "name": "propDiameter",
        "unit": "in"
      },
      {
        "name": "ct0",
        "description": "thrust coefficient CT(J) = ct0 + ct1 J + ct2 J²"
      },
      {
        "name": "ct1"
      },
      {
        "name": "ct2"
      },
      {
        "name": "cp0",
        "description": "power coefficient CP(J) = cp0 + cp1 J + cp2 J²"
      },
      {
        "name": "cp1"
      },
      {
        "name": "cp2"
      },
      {
        "name": "motorKv",
        "unit": "rpm/V"
      },
      {
        "name": "motorResistance",
        "unit": "ohm"
      },
      {
        "name": "motorNoLoadCurrent",
        "unit": "A"
      },
      {
        "name": "motorMaxCurrent",
        "unit": "A"
      },
      {
        "name": "batteryVoltage",
        "unit": "V"
      },
      {
        "name": "batteryEnergy",
        "unit": "Wh"
      },
      {
        "name": "batteryMaxPower",
        "unit": "W"
      },
      {
        "name": "airDensity",
        "unit": "kg/m3",
        "description": "constant"
      },
      {
        "name": "reserve",
        "description": "fraction of the pack kept back"
      }
    ],
    "outputs": [
      {
        "name": "energyUsed",
        "unit": "Wh"
      },
      {
        "name": "energyPercent",
        "unit": "%"
      },
      {
        "name": "missionTime",
        "unit": "s"
      },
      {
        "name": "endStateOfCharge",
        "unit": "%"
      },
      {
        "name": "reserveMargin",
        "unit": "%"
      },
      {
        "name": "peakPower",
        "unit": "W"
      },
      {
        "name": "averagePower",
        "unit": "W"
      },
      {
        "name": "maxThrottle"
      },
      {
        "name": "distanceFlown",
        "unit": "m"
      },
      {
        "name": "completed"
      },
      {
        "name": "feasible"
      },
      {
        "name": "limitingStep"
      },
      {
        "name": "issues"
      },
      {
        "name": "behaviors"
      },
      {
        "name": "flownSteps"
      },
      {
        "name": "propellerCurves"
      },
      {
        "name": "motorCurves"
      },
      {
        "name": "reference"
      },
      {
        "name": "timeline"
      }
    ]
  },
  {
    "name": "componentCurves",
    "kind": "external",
    "description": "Performance curves of one propeller (CT, CP against advance ratio) or motor (full-throttle torque, speed, power, efficiency against current), as the dynamics simulator uses them (mission simulator service).",
    "endpointUrl": "http://mission-sim:8011/curves",
    "inputs": [
      {
        "name": "component",
        "description": "propeller or motor"
      },
      {
        "name": "ct0"
      },
      {
        "name": "ct1"
      },
      {
        "name": "ct2"
      },
      {
        "name": "cp0"
      },
      {
        "name": "cp1"
      },
      {
        "name": "cp2"
      },
      {
        "name": "kv",
        "unit": "rpm/V"
      },
      {
        "name": "resistance",
        "unit": "ohm"
      },
      {
        "name": "noLoadCurrent",
        "unit": "A"
      },
      {
        "name": "maxCurrent",
        "unit": "A"
      },
      {
        "name": "voltage",
        "unit": "V",
        "description": "supply voltage for a motor's full-throttle curves"
      }
    ],
    "outputs": [
      {
        "name": "curves"
      },
      {
        "name": "summary"
      }
    ],
    "timeoutSeconds": 10
  },
  {
    "name": "controlSimulator",
    "kind": "external",
    "version": "2",
    "description": "Controllability of a multirotor (mission simulator service): 6-DOF rigid body with rotor and motor dynamics and reaction torques, a command mixer and cascaded PID loops down to each ESC. mode=tune identifies the dynamics from open-loop tests and proposes gains; mode=verify uses the given gains (rpmKp ... positionKp, rpmLoop). Both fly the control tests given (climb-rate, speed or heading steps, gusts) and report each one's results under testResults[requirement].",
    "endpointUrl": "http://mission-sim:8011/control",
    "inputs": [
      {
        "name": "mode",
        "description": "tune or verify"
      },
      {
        "name": "tests",
        "description": "control tests to fly: requirement, command (climbRate, speed, heading, gust), step, rate, hold"
      },
      {
        "name": "rotorCount"
      },
      {
        "name": "takeoffMass",
        "unit": "kg"
      },
      {
        "name": "armLength",
        "unit": "m"
      },
      {
        "name": "inertiaXX",
        "unit": "kg*m**2"
      },
      {
        "name": "inertiaYY",
        "unit": "kg*m**2"
      },
      {
        "name": "inertiaZZ",
        "unit": "kg*m**2"
      },
      {
        "name": "rotorInertia",
        "unit": "kg*m**2"
      },
      {
        "name": "firstRotorSpin"
      },
      {
        "name": "dragArea",
        "unit": "m**2"
      },
      {
        "name": "propDiameter",
        "unit": "in"
      },
      {
        "name": "ct0"
      },
      {
        "name": "cp0"
      },
      {
        "name": "motorKv",
        "unit": "rpm/V"
      },
      {
        "name": "motorResistance",
        "unit": "ohm"
      },
      {
        "name": "motorNoLoadCurrent",
        "unit": "A"
      },
      {
        "name": "motorMaxCurrent",
        "unit": "A"
      },
      {
        "name": "batteryVoltage",
        "unit": "V"
      },
      {
        "name": "maxTilt",
        "unit": "deg"
      },
      {
        "name": "maxYawRate",
        "unit": "deg/s"
      },
      {
        "name": "rpmLoop",
        "description": "true: the ESCs hold the commanded speed"
      }
    ],
    "outputs": [
      {
        "name": "gains"
      },
      {
        "name": "mixer"
      },
      {
        "name": "hover"
      },
      {
        "name": "identification"
      },
      {
        "name": "margins"
      },
      {
        "name": "scenarios"
      },
      {
        "name": "testResults"
      },
      {
        "name": "issues"
      },
      {
        "name": "completed"
      },
      {
        "name": "phaseMargin",
        "unit": "deg"
      },
      {
        "name": "gainMargin",
        "unit": "dB"
      },
      {
        "name": "thrustMargin"
      },
      {
        "name": "yawAuthority"
      },
      {
        "name": "saturation",
        "unit": "%"
      },
      {
        "name": "climbSettlingTime",
        "unit": "s"
      },
      {
        "name": "speedSettlingTime",
        "unit": "s"
      },
      {
        "name": "speedOvershoot",
        "unit": "%"
      },
      {
        "name": "headingSettlingTime",
        "unit": "s"
      },
      {
        "name": "gustDeviation",
        "unit": "m"
      },
      {
        "name": "rpmKp"
      },
      {
        "name": "rpmKi"
      },
      {
        "name": "rateKp"
      },
      {
        "name": "rateKi"
      },
      {
        "name": "rateKd"
      },
      {
        "name": "yawRateKp"
      },
      {
        "name": "yawRateKi"
      },
      {
        "name": "attitudeKp"
      },
      {
        "name": "headingKp"
      },
      {
        "name": "velocityKp"
      },
      {
        "name": "velocityKi"
      },
      {
        "name": "verticalKp"
      },
      {
        "name": "verticalKi"
      },
      {
